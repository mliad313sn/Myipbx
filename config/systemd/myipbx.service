[Unit]
Description=Legacy-to-Modern IPBX Appliance control plane
Documentation=file:/opt/myipbx/README.md
After=network-online.target asterisk.service
Wants=network-online.target

# Constraint One, expressed as a scheduling fact rather than only as a policy:
# the appliance is ordered after the network is already addressed, because it
# never participates in addressing it.
After=dahdi.service

# The console is served over a secured transport, and the certificate for it is
# generated on this appliance rather than shipped to it. This is a want rather
# than a requirement: if the generation fails, the control plane still starts
# and refuses to serve with a message naming the file it could not read, which
# tells an operator more than a dependency that was never scheduled.
Wants=myipbx-certificate.service
After=myipbx-certificate.service

[Service]
Type=simple
User=myipbx
Group=myipbx
WorkingDirectory=/opt/myipbx
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MYIPBX_CONFIGURATION_DOCUMENT=/etc/myipbx/appliance.json
ExecStart=/usr/bin/python3 -m appliance
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# The control plane needs to read the engine configuration directory and its
# own state, and nothing else.  Everything below is the smallest set of
# privileges that leaves it able to do its job.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# A path prefixed with a leading dash is ignored when it is absent.  The
# engine configuration directory does not exist until stage four has run, and
# the interface driver's exported tree does not exist until a card is fitted
# and its driver is loaded.  Without the dash, systemd refuses to set up the
# mount namespace and the appliance fails to start on exactly the machines it
# is meant to be brought up on first.
ReadWritePaths=/var/lib/myipbx /var/log/myipbx -/etc/asterisk
ReadOnlyPaths=-/etc/myipbx -/proc/dahdi

# The appliance serves the dashboard and speaks to the engine over the
# loopback address.  It has no reason for any other address family, and no
# reason ever to bind an address allocation service port.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
